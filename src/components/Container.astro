---
/** The marketing measure: 1200px, centred, 32px gutters (16px below 768px). */
interface Props {
  /** Drop to the 760px reading width for prose-only sections. */
  narrow?: boolean;
  class?: string;
}

const { narrow = false, class: className } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-4 md:px-8',
    narrow ? 'max-w-form' : 'max-w-marketing',
    className,
  ]}
>
  <slot />
</div>
