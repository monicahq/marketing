---
import Container from './Container.astro';

/**
 * One band of the page. Sections are separated by a one-pixel rule and by
 * alternating canvas / subtle surfaces — never by a shadow, and never by a
 * gradient. Vertical rhythm is 60px below 1024px and 88px above.
 */
interface Props {
  id?: string;
  surface?: 'canvas' | 'subtle';
  border?: 'none' | 'top' | 'top-bottom';
  narrow?: boolean;
  /** Off for bands that set their own vertical padding, like the proof strip. */
  padded?: boolean;
  /** Extra classes for the inner container. */
  class?: string;
}

const {
  id,
  surface = 'canvas',
  border = 'none',
  narrow = false,
  padded = true,
  class: className,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    surface === 'subtle' && 'bg-surface-subtle',
    border !== 'none' && 'border-t border-border',
    border === 'top-bottom' && 'border-b',
  ]}
>
  <Container narrow={narrow} class:list={[padded && 'py-section-sm lg:py-section', className]}>
    <slot />
  </Container>
</section>
