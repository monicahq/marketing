---
import Section from '../Section.astro';
import BulletList from '../BulletList.astro';
import { site } from '../../config';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Two independent units, so each one earns its border. */
const plans = [
  { ...t.plans.hosted, href: site.links.createAccount, variant: 'mn-btn--primary' },
  { ...t.plans.selfHosted, href: site.links.selfHost, variant: 'mn-btn--secondary' },
];
---

<Section id="pricing" surface="subtle" border="top">
  <h2 class="text-heading font-semibold lg:text-display-md">{t.plans.title}</h2>

  <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-6">
    {
      plans.map((plan) => (
        <div class="flex flex-col rounded-lg border border-border bg-surface p-region">
          <h3 class="text-heading-sm font-semibold">{plan.title}</h3>
          <p class="mt-3 text-copy text-text-secondary text-pretty">{plan.body}</p>
          <BulletList items={plan.items} />
          <a
            href={plan.href}
            class:list={['mn-btn mt-8 self-start no-underline hover:no-underline', plan.variant]}
          >
            {plan.cta}
          </a>
        </div>
      ))
    }
  </div>
</Section>
