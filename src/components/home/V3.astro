---
import Section from '../Section.astro';
import FeatureItem from '../FeatureItem.astro';
import { site } from '../../config';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const body = 'max-w-[62ch] text-copy-lg text-text-secondary text-pretty';
---

<Section border="top">
  <h2 class="text-heading font-semibold lg:text-display-md">{t.v3.title}</h2>
  <p class:list={['mt-5', body]}>{t.v3.body}</p>
  <p class:list={['mt-4', body]}>{t.v3.body2}</p>

  <div class="mt-10 font-mono text-mono text-text-muted">{t.v3.listLabel}</div>

  <div class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6">
    {
      t.v3.features.map((feature, index) => (
        <FeatureItem {...feature} layout="stacked" rule={index < 3 ? 'standard' : 'quiet'} />
      ))
    }
  </div>

  <div class="mt-10 flex flex-wrap items-center gap-4">
    <a href={site.links.v3} class="mn-btn mn-btn--primary no-underline hover:no-underline">
      {t.v3.cta}
    </a>
    <span class="font-mono text-mono text-text-muted">{t.v3.note}</span>
  </div>
</Section>
