---
import Section from '../Section.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';
import { getStarCount } from '../../lib/github';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const stars = await getStarCount();

const stats = [
  { value: stars, label: t.proof.starsLabel },
  { value: t.proof.since, label: t.proof.sinceLabel },
  { value: t.proof.featured, label: t.proof.featuredLabel },
  { value: t.proof.launch, label: t.proof.launchLabel },
];
---

<Section surface="subtle" border="top-bottom" padded={false} class="py-10">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-8">
    {
      stats.map((stat) => (
        <div>
          <div class="text-heading font-semibold">{stat.value}</div>
          <div class="mt-2 font-mono text-mono text-text-muted">{stat.label}</div>
        </div>
      ))
    }
  </div>
  <p class="mt-8 text-copy leading-[1.6] text-text-muted italic">{t.proof.aside}</p>
</Section>
