---
import Section from '../Section.astro';
import { site } from '../../config';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section border="top" narrow>
  <h2 class="text-heading font-semibold lg:text-display-md">{t.finalCta.title}</h2>
  <p class="mt-5 text-copy-lg text-text-secondary text-pretty">{t.finalCta.body}</p>

  <div class="mt-8 flex flex-wrap gap-3">
    <a href={site.links.getStarted} class="mn-btn mn-btn--primary no-underline hover:no-underline">
      {t.finalCta.primaryCta}
    </a>
    <a href={site.links.v3} class="mn-btn mn-btn--secondary no-underline hover:no-underline">
      {t.finalCta.secondaryCta}
    </a>
  </div>

  <p class="mt-5 font-mono text-mono text-text-muted">{t.finalCta.note}</p>
</Section>
