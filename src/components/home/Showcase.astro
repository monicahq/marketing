---
import Section from '../Section.astro';
import ContactCard from './ContactCard.astro';
import FeatureItem from '../FeatureItem.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section surface="subtle" border="top">
  <h2 class="text-heading font-semibold lg:text-display-md">{t.showcase.title}</h2>
  <p class="mt-5 max-w-[56ch] text-copy leading-[1.6] text-text-muted italic">
    {t.showcase.aside}
  </p>

  <div
    class="mt-8 grid grid-cols-1 items-start gap-8 lg:mt-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12"
  >
    <ContactCard locale={locale} />

    <div class="flex flex-col gap-6">
      {t.showcase.features.map((feature) => <FeatureItem {...feature} />)}
    </div>
  </div>
</Section>
