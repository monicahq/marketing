---
import Section from '../Section.astro';
import BulletList from '../BulletList.astro';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Section class="grid grid-cols-[repeat(auto-fit,minmax(320px,1fr))] gap-16">
  <div>
    <h2 class="text-heading font-semibold lg:text-display-md">{t.notALead.title}</h2>
    <p class="mt-5 max-w-[52ch] text-copy-lg text-text-secondary text-pretty">{t.notALead.body}</p>
    <p class="mt-8 text-copy leading-[1.6] text-text-muted italic">{t.notALead.aside}</p>
  </div>

  <div>
    <p class="text-copy font-medium text-text">{t.notALead.listTitle}</p>
    <BulletList items={t.notALead.items} />
  </div>
</Section>
