---
import pandaMark from '../assets/monica-panda-mark.jpg';
import { site } from '../config';
import { defaultLocale, ogLocales, type Locale } from '../i18n/config';
import { alternates, type PageKey } from '../i18n/routes';
import { useTranslations } from '../i18n/ui';

/**
 * Everything a crawler or a link preview needs. Kept out of BaseLayout so the
 * shell stays readable and every future page gets the same treatment by
 * passing the same two props.
 *
 * The multilingual half matters as much as the tags themselves: each page
 * declares a canonical for itself, an hreflang for all four translations
 * including itself (reciprocity is what makes Google trust the cluster), and
 * an x-default for readers whose language is not one of ours.
 */
interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;

const t = useTranslations(locale);
const alternateLinks = alternates(page);

/** Absolute URLs throughout. Crawlers and scrapers do not resolve relative ones. */
const absolute = (path: string) => new URL(path, Astro.site).href;

const canonical = absolute(Astro.url.pathname);
const xDefault = alternateLinks.find((entry) => entry.locale === defaultLocale)!;

/**
 * One card per locale, so a link shared in French previews in French.
 * 1200x630, generated by `npm run og`.
 */
const ogImage = absolute(`/og/monica-${locale}.png`);

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': absolute('/#organization'),
      name: 'Monica',
      url: absolute('/'),
      logo: absolute(pandaMark.src),
      sameAs: [site.links.github],
    },
    {
      '@type': 'WebSite',
      '@id': absolute('/#website'),
      name: 'Monica',
      url: absolute('/'),
      description,
      inLanguage: locale,
      publisher: { '@id': absolute('/#organization') },
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{/* Allow full-size image previews and untruncated snippets in search results. */}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

{
  alternateLinks.map(({ locale: alternate, path }) => (
    <link rel="alternate" hreflang={alternate} href={absolute(path)} />
  ))
}
<link rel="alternate" hreflang="x-default" href={absolute(xDefault.path)} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Monica" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocales[locale]} />
{
  alternateLinks
    .filter((entry) => entry.locale !== locale)
    .map((entry) => <meta property="og:locale:alternate" content={ogLocales[entry.locale]} />)
}
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t.meta.imageAlt} />

{/* X and Slack read og:title, og:description and og:image directly. The card
    type has no Open Graph equivalent, so it has to be stated. */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={t.meta.imageAlt} />

<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
