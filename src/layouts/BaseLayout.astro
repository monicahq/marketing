---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { defaultLocale, type Locale } from '../i18n/config';
import { alternates, type PageKey } from '../i18n/routes';

/**
 * The page shell every marketing page shares: announcement bar, header, content,
 * footer — plus the per-locale head. `page` drives the hreflang alternates, so
 * search engines are told about all four translations of this exact page.
 */
interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
const alternateLinks = alternates(page);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      alternateLinks.map(({ locale: alternate, path }) => (
        <link rel="alternate" hreflang={alternate} href={new URL(path, Astro.site)} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternateLinks.find((entry) => entry.locale === defaultLocale)!.path, Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
  </head>

  <body class="min-h-screen bg-canvas font-sans text-text">
    <AnnouncementBar locale={locale} />
    <SiteHeader locale={locale} />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
