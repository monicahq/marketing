---
import '../styles/global.css';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { Locale } from '../i18n/config';
import type { PageKey } from '../i18n/routes';

/**
 * The page shell every marketing page shares: announcement bar, header, content,
 * footer, and the per-locale head. `page` is what lets Seo.astro emit hreflang
 * links for all four translations of this exact page.
 */
interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
}

const { locale, page, title, description } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <Seo locale={locale} page={page} title={title} description={description} />
  </head>

  <body class="min-h-screen bg-canvas font-sans text-text">
    <AnnouncementBar locale={locale} />
    <SiteHeader locale={locale} />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
