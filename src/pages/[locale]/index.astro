---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import ProofStrip from '../../components/home/ProofStrip.astro';
import NotALead from '../../components/home/NotALead.astro';
import Showcase from '../../components/home/Showcase.astro';
import NotSocial from '../../components/home/NotSocial.astro';
import OpenSource from '../../components/home/OpenSource.astro';
import V3 from '../../components/home/V3.astro';
import Founder from '../../components/home/Founder.astro';
import Faq from '../../components/home/Faq.astro';
import Plans from '../../components/home/Plans.astro';
import FinalCta from '../../components/home/FinalCta.astro';
import { locales, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

/** One homepage per locale: /en/, /fr/, /de/, /es/. */
export const getStaticPaths = (() =>
  locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} page="home" title={t.meta.title} description={t.meta.description}>
  <Hero locale={locale} />
  <ProofStrip locale={locale} />
  <NotALead locale={locale} />
  <Showcase locale={locale} />
  <NotSocial locale={locale} />
  <OpenSource locale={locale} />
  <V3 locale={locale} />
  <Founder locale={locale} />
  <Faq locale={locale} />
  <Plans locale={locale} />
  <FinalCta locale={locale} />
</BaseLayout>
